{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "seed": "node ./build.mjs && node --enable-source-maps ./dist/seed.mjs",
    "migrate:repair-ai-status": "node ./build.mjs && node --enable-source-maps ./dist/migrate-repair-ai-status.mjs",
    "migrate:multitenancy": "node ./build.mjs && node --enable-source-maps ./dist/migrate-multitenancy.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hubspot/api-client": "^13.5.0",
    "@replit/connectors-sdk": "^0.4.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-anthropic-ai": "workspace:*",
    "apify-client": "^2.23.3",
    "bcrypt": "^6.0.0",
    "canvas": "^3.2.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "express-rate-limit": "^8.4.1",
    "firebase-admin": "^13.8.0",
    "helmet": "^8.1.0",
    "jspdf": "^4.2.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.7",
    "pino": "^9",
    "pino-http": "^10",
    "sanitize-html": "^2.17.4",
    "stripe": "^17.7.0",
    "stripe-replit-sync": "^1.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.0",
    "@types/sanitize-html": "^2.16.1",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "thread-stream": "3.1.0"
  }
}
