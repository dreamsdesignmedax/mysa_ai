{
  "buildAptPackages": [
    "build-essential",
    "python3",
    "libcairo2-dev",
    "libpango1.0-dev",
    "libjpeg-dev",
    "libgif-dev",
    "librsvg2-dev",
    "libatomic1"
  ],
  "steps": {
    "install": {
      "commands": [
        "pnpm install --no-frozen-lockfile --prefer-offline"
      ]
    },
    "build": {
      "commands": [
        "pnpm --filter @workspace/api-server run build",
        "pnpm --filter @workspace/mysa-b2c-v3 run build"
      ]
    }
  },
  "deploy": {
    "startCommand": "pnpm --filter @workspace/api-server run start"
  }
}
